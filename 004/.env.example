# Gym 004 overlay merged with ../config/tracecat.env.example by `just init`.
PUBLIC_APP_PORT=48080
PUBLIC_APP_URL=http://127.0.0.1:48080
PUBLIC_API_URL=http://127.0.0.1:48080/api
BASE_DOMAIN=:48080
NEXT_PUBLIC_APP_URL=http://127.0.0.1:48080
NEXT_PUBLIC_API_URL=http://127.0.0.1:48080/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:48080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:48080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:48080,http://localhost:48080
TRACECAT__AUTH_SUPERADMIN_EMAIL=superadmin@gym-004.example.com
TRACEcat_TENANT_EMAIL=analyst@gym-004.example.com
TRACEcat_TENANT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACEcat_SUPERADMIN_EMAIL=superadmin@gym-004.example.com
TRACEcat_SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACECAT__LOCAL_REPOSITORY_PATH=/tmp/gym-004-local-registry

# Operator-supplied evidence; never committed or included in the control image.
GROUNDLINK_CORPUS=./assets/groundlink.json.gz
GROUNDLINK_BUCKET=groundlink
GROUNDLINK_ENDPOINT=minio:9000
